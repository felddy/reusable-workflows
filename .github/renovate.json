{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track any version pin annotated with a `# renovate:` comment on the preceding line",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\n\\s*[^:\\n]+:\\s*\"?(?<currentValue>[^\\s\"']+?)\"?\\n"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "depNameTemplate": "moby/buildkit",
      "description": "Track the BuildKit driver image inside the setup-buildx driver-opts block (block scalars cannot carry inline annotations)",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/container-build\\.yml$/"
      ],
      "matchStrings": [
        "image=moby/buildkit:(?<currentValue>v[\\d.]+)"
      ],
      "versioningTemplate": "docker"
    }
  ],
  "enabledManagers": [
    "custom.regex",
    "pre-commit"
  ],
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "labels": [
        "bot :robot:",
        "dependencies :game_die:"
      ],
      "matchManagers": [
        "custom.regex",
        "pre-commit"
      ]
    },
    {
      "description": "The manager's built-in .pre-commit-config.yaml pattern cannot be removed (managerFilePatterns is additive, so the pattern below only adds the base); the file is generated, never update it directly",
      "enabled": false,
      "matchFileNames": [
        ".pre-commit-config.yaml"
      ],
      "matchManagers": [
        "pre-commit"
      ]
    },
    {
      "description": "A base bump must regenerate this repo's own config in the same commit, or the lint-config-check hook fails the PR; the commands must stay in sync with RENOVATE_ALLOWED_COMMANDS in .github/workflows/renovate.yml",
      "matchManagers": [
        "pre-commit"
      ],
      "postUpgradeTasks": {
        "commands": [
          "python3 -m pip install --user pyyaml==6.0.3",
          "python3 tools/merge_precommit.py lint-config/pre-commit-base.yaml .pre-commit-overlay.yaml --output .pre-commit-config.yaml"
        ],
        "executionMode": "branch",
        "fileFilters": [
          ".pre-commit-config.yaml"
        ],
        "installTools": {
          "python": {}
        }
      }
    }
  ],
  "pre-commit": {
    "description": "Hook revisions are pinned only in the central base; the generated .pre-commit-config.yaml follows it via the lint-config sync",
    "enabled": true,
    "managerFilePatterns": [
      "/^lint-config\\/pre-commit-base\\.yaml$/"
    ]
  }
}
