#!/usr/bin/env sh

# render-docs-update: regenerate every rendered document from its template.
#
# Renders every '*.j2' template in the repository from the platform list
# in .github/workflows/_build.yml and writes the outputs in place.

set -eu

if ! command -v uv > /dev/null 2>&1; then
  echo "ERROR: uv is required but not on the PATH." >&2
  exit 1
fi

exec uv run --group docs python tools/render_docs.py --all
